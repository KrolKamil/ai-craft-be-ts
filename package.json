{
    "name": "devices",
    "version": "1.0.0",
    "description": "AI Craftsmanship Workshop Project",
    "author": "Michal Michaluk",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=23.6.0"
    },
    "packageManager": "npm@11.3.0",
    "scripts": {
        "build": "nest build",
        "build:prod": "NODE_ENV=production nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "dev": "cross-env PORT=3001 nest start --watch",
        "start": "nest start",
        "start:dev": "cross-env PORT=3001 nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "test": "vitest run --exclude=\"**/*.ext.*.ts\"",
        "test:watch": "vitest watch --exclude=\"**/*.ext.*.ts\"",
        "test:cov": "vitest run --coverage",
        "test:ext": "vitest run",
        "test:debug": "vitest --inspect-brk",
        "prepare": "husky"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.5",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.5",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/platform-express": "^11.1.5",
        "@nestjs/schedule": "^6.0.0",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/terminus": "^11.0.0",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "axios": "^1.11.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "uuid": "^11.1.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/config-array": "^0.21.0",
        "@eslint/object-schema": "^2.1.6",
        "@nestjs/cli": "^11.0.7",
        "@nestjs/schematics": "^11.0.5",
        "@nestjs/testing": "^11.1.5",
        "@swc/core": "^1.13.2",
        "@testcontainers/postgresql": "^11.4.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.1.0",
        "@types/pg": "^8.15.4",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.44.1",
        "@typescript-eslint/parser": "^8.44.1",
        "@vitest/coverage-v8": "^3.2.4",
        "cross-env": "^10.0.0",
        "dotenv": "^17.2.1",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.44.1",
        "unplugin-swc": "^1.5.5",
        "vitest": "^3.2.4",
        "wait-for-expect": "^3.0.2"
    }
}
